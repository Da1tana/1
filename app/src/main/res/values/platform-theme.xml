<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="platformActivityTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/nc_accent</item>

        <item name="android:statusBarColor">@color/nc_base</item>
        <item name="android:navigationBarColor">@color/nc_base</item>
        <item name="android:colorBackground">@color/nc_base</item>
        <item name="android:windowBackground">@color/nc_base</item>
        <item name="android:colorForeground">@color/nc_text</item>
        <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
    </style>

    <style name="AlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/nc_accent</item>
        <item name="android:background">@color/nc_base</item>
        <item name="android:textColor">@color/nc_text</item>
        <item name="android:textColorPrimary">@color/nc_text</item>
        <item name="android:textColorAlertDialogListItem">@color/nc_text</item>
        <item name="android:colorForeground">@color/nc_text</item>
    </style>
</resources>
